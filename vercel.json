{
  "version": 2,
  "builds": [
    {
      "src": "api/scan.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.{html,css,js}",
      "use": "@vercel/static"
    },
    {
      "src": "!(api/**)",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/scan",
      "dest": "/api/scan.js"
    },
    {
      "src": "/(script.js|style.css|index.html)",
      "dest": "/$1"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
