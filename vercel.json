{
  "version": 2,
  "builds": [
    {
      "src": "api/scan.js",
      "use": "@vercel/node"
    },
    {
      "src": "!(api/**)",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/scan",
      "dest": "/api/scan.js"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    },
    {
      "src": "/(style.css|script.js)",
      "dest": "/$1"
    }
  ]
}
